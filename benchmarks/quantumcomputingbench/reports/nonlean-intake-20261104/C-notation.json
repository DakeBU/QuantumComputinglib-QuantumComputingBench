    {
      "slot": "C2",
      "question_sha256": "267dd3396f5543531d781e4b6611d46d5c4348947b9f8e8ddd1baffd71b7cb2e",
      "equations": [
        {
          "source_excerpt": "r_0,...,r_n be finite bond dimensions with r_0=r_n=1",
          "tex": "r_0,\\ldots,r_n\\in\\mathbb N,\\qquad r_0=r_n=1.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "A_j^0,A_j^1 of size r_{j-1} by r_j for each j=1,...,n",
          "tex": "A_j^0,A_j^1\\in\\mathbb R^{r_{j-1}\\times r_j},\\qquad 1\\le j\\le n.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "P_A(s)=A_1^{s_1}...A_n^{s_n}",
          "tex": "P_A(s)=A_1^{s_1}\\cdots A_n^{s_n}.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "Its squared mass is S=sum_{s in {0,1}^n} f(s)^2 and its Euclidean norm is sqrt(S).",
          "tex": "S=\\sum_{s\\in\\{0,1\\}^n}f(s)^2,\\qquad \\|f\\|_2=\\sqrt S.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "set G_0=G_n=I_1. Define transformed slices B_j^s=G_{j-1}^{-1} A_j^s G_j.",
          "tex": "G_0=G_n=I_1,\\qquad B_j^s=G_{j-1}^{-1}A_j^sG_j.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "Call the train right-canonical if sum_{s=0}^1 A_j^s(A_j^s)^T=I_{r_{j-1}} at every j.",
          "tex": "\\text{Right-canonical:}\\quad \\sum_{s=0}^1 A_j^s(A_j^s)^T=I_{r_{j-1}}\\quad (1\\le j\\le n).",
          "purpose": "given_question_notation"
        }
      ]
    },
    {
      "slot": "C3",
      "question_sha256": "776439a16abc8b20a757a0dc1e0a238a6defc29cf18d1dfb51cecf158a12720b",
      "equations": [
        {
          "source_excerpt": "Set P_A(s)=A_1^{s_1}...A_n^{s_n} and P_B(s)=B_1^{s_1}...B_n^{s_n}.",
          "tex": "P_A(s)=A_1^{s_1}\\cdots A_n^{s_n},\\qquad P_B(s)=B_1^{s_1}\\cdots B_n^{s_n}.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "H_n=I_r and H_{j-1}=sum_{t=0}^1 A_j^t H_j (B_j^t)^T.",
          "tex": "H_n=I_r,\\qquad H_{j-1}=\\sum_{t=0}^1 A_j^t H_j(B_j^t)^T.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "Phi_A(v)_{s,b}=sum_a v_a P_A(s)_{ab} and Phi_B(w)_{s,b}=sum_c w_c P_B(s)_{cb}.",
          "tex": "\\Phi_A(v)_{s,b}=\\sum_a v_aP_A(s)_{ab},\\qquad \\Phi_B(w)_{s,b}=\\sum_c w_cP_B(s)_{cb}.",
          "purpose": "given_question_notation"
        }
      ]
    },
    {
      "slot": "C4",
      "question_sha256": "ff9187905d07cd57e1adad33ff98abc17ff7c7c037ec8d7254ea176aa4d0a51e",
      "equations": [
        {
          "source_excerpt": "B_{d,r}(t)=binom(d,r)t^r(1-t)^{d-r}",
          "tex": "B_{d,r}(t)=\\binom dr t^r(1-t)^{d-r},\\qquad 0\\le r\\le d.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "|ctilde_r-c_r|<=eta for every r, where eta>=0",
          "tex": "|\\widetilde c_r-c_r|\\le\\eta\\quad(0\\le r\\le d),\\qquad \\eta\\ge0.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "p(t)=sum_{r=0}^d c_r B_{d,r}(t) and ptilde(t)=sum_{r=0}^d ctilde_r B_{d,r}(t).",
          "tex": "p(t)=\\sum_{r=0}^dc_rB_{d,r}(t),\\qquad \\widetilde p(t)=\\sum_{r=0}^d\\widetilde c_rB_{d,r}(t).",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "define raw sample vectors x=(p(t_j)) and y=(ptilde(t_j)) in R^M.",
          "tex": "x=\\bigl(p(t_j)\\bigr)_{j=1}^M,\\qquad y=\\bigl(\\widetilde p(t_j)\\bigr)_{j=1}^M\\in\\mathbb R^M.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "Assume a known lower bound ||x||_2^2>=m>0 and eta*sqrt(M)<sqrt(m).",
          "tex": "\\|x\\|_2^2\\ge m>0,\\qquad \\eta\\sqrt M<\\sqrt m.",
          "purpose": "given_question_notation"
        }
      ]
    }
  ]
