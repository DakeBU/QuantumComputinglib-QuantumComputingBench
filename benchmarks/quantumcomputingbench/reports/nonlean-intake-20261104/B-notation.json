      "equations": [
        {
          "source_excerpt": "Assume for each stage index t and each clean input column (fresh bit input = 0, bond input a) the stage entry equals the corresponding tensor core entry K t.",
          "tex": "\\text{stage entry at a clean input column}=\\text{corresponding entry of }K_t,\\qquad \\text{fresh bit input}=0.",
          "purpose": "given_question_notation"
        }
      ]
    },
    {
      "slot": "B2",
      "question_sha256": "74661287957a3aebfdb76e251de9bd74003ce9066014e95267f9eba00b431d8d",
      "equations": [
        {
          "source_excerpt": "V_λ|0⟩=exp(iφ_λ)ψ_λ",
          "tex": "V_{\\lambda}|0\\rangle=e^{i\\phi_{\\lambda}}\\psi_{\\lambda}.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "W=Σ_λ |λ⟩⟨λ|⊗V_λ",
          "tex": "W=\\sum_{\\lambda\\in\\Lambda}|\\lambda\\rangle\\langle\\lambda|\\otimes V_{\\lambda}.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "Σ_λ|c_λ|²=1",
          "tex": "\\sum_{\\lambda\\in\\Lambda}|c_{\\lambda}|^2=1.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "Ψ=Σ_λ c_λ|λ⟩⊗ψ_λ",
          "tex": "\\Psi=\\sum_{\\lambda\\in\\Lambda}c_{\\lambda}|\\lambda\\rangle\\otimes\\psi_{\\lambda}.",
          "purpose": "given_question_notation"
        }
      ]
    },
    {
      "slot": "B3",
      "question_sha256": "aca742e0e218eba2a536fd412c46e879473851f2164b337b4d2c6d18c067fe18",
      "equations": [
        {
          "source_excerpt": "U=U_{N-1}...U_0",
          "tex": "U=U_{N-1}\\cdots U_0.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "R(a)=[[cos(a/2),-sin(a/2)],[sin(a/2),cos(a/2)]]",
          "tex": "R(a)=\\begin{pmatrix}\\cos(a/2)&-\\sin(a/2)\\\\ \\sin(a/2)&\\cos(a/2)\\end{pmatrix}.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "||R(a)-R(b)||=2|sin((a-b)/4)|≤|a-b|/2",
          "tex": "\\|R(a)-R(b)\\|=2\\left|\\sin\\!\\left(\\frac{a-b}{4}\\right)\\right|\\leq\\frac{|a-b|}{2}.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "||V-U||≤(1/2)Σ_j m_jδ_j",
          "tex": "\\|V-U\\|\\leq\\frac12\\sum_{j=1}^{r}m_j\\delta_j.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "T(δ)=Σ_j c_j log₂(1/δ_j) subject to Σ_j m_jδ_j≤2η",
          "tex": "T(\\delta)=\\sum_{j=1}^{r}c_j\\log_2\\!\\left(\\frac1{\\delta_j}\\right),\\qquad \\sum_{j=1}^{r}m_j\\delta_j\\leq2\\eta.",
          "purpose": "given_question_notation"
        }
      ]
    },
    {
      "slot": "B4",
      "question_sha256": "1d91c915bfd8ed5f0384792865496f29534d1b39d66cb5f4787e92d0a173f544",
      "equations": [
        {
          "source_excerpt": "F(w)=ℓ A_0(w_0)...A_{n-1}(w_{n-1})r",
          "tex": "F(w)=\\ell A_0(w_0)\\cdots A_{n-1}(w_{n-1})r.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "L_n(x)=Σ_{i=0}^{n-1}x_i2^i, reversal (ρ_n x)_i=x_{n-1-i}, and S_n(w)=L_n(ρ_n x(w))",
          "tex": "L_n(x)=\\sum_{i=0}^{n-1}x_i2^i,\\qquad(\\rho_nx)_i=x_{n-1-i},\\qquad S_n(w)=L_n(\\rho_n x(w)).",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "M(empty)=0 and M(b::u)=b·2^{length(u)}+M(u)",
          "tex": "M(\\varnothing)=0,\\qquad M(b::u)=b\\,2^{\\operatorname{length}(u)}+M(u).",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "F(w)=f(M(w))",
          "tex": "F(w)=f(M(w)).",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "v=Σ_w F(w)|x(w)⟩ and the intended little-endian vector t=Σ_x f(L_n(x))|x⟩",
          "tex": "v=\\sum_wF(w)|x(w)\\rangle,\\qquad t=\\sum_x f(L_n(x))|x\\rangle.",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "P|x⟩=|ρ_n x⟩",
          "tex": "P|x\\rangle=|\\rho_nx\\rangle.",
          "purpose": "given_question_notation"
        }
      ]
    }
  ]
