      "question_sha256": "9d2e40ad456fd8a6c36088a30caacf66258a59392695826329424d2ee4ee0e89",
      "equations": [
        {
          "source_excerpt": "H=C^(2^n) the system space and K=C^(2^m) the ancilla space, in the fixed tensor order K tensor H",
          "source_start": 33,
          "source_end": 129,
          "tex": "H=\\mathbb C^{2^n},\\qquad K=\\mathbb C^{2^m},\\qquad K\\otimes H",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "J:H→K tensor H by Jv=|0^m> tensor v, the projector P=JJ†, and the clean block B=J†UJ",
          "source_start": 255,
          "source_end": 339,
          "tex": "J:H\\longrightarrow K\\otimes H,\\qquad Jv=\\lvert0^m\\rangle\\otimes v,\\qquad P=JJ^\\dagger,\\quad B=J^\\dagger UJ",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "alpha>0 and epsilon>=0, and assume the induced Euclidean operator-norm bound ||A-alpha B||<=epsilon",
          "source_start": 406,
          "source_end": 505,
          "tex": "\\alpha>0,\\qquad \\epsilon\\ge0,\\qquad \\lVert A-\\alpha B\\rVert\\le\\epsilon",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "psi has ||psi||=1. Put s=||A psi|| and assume s>epsilon.",
          "source_start": 522,
          "source_end": 578,
          "tex": "\\lVert\\psi\\rVert=1,\\qquad s=\\lVert A\\psi\\rVert>\\epsilon",
          "purpose": "given_question_notation"
        }
