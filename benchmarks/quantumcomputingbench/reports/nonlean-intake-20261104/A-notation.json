        {
          "source_excerpt": "||z||=(sum_j |z_j|^2)^(1/2)",
          "source_start": 70,
          "source_end": 97,
          "tex": "\\lVert z\\rVert=\\left(\\sum_j |z_j|^2\\right)^{1/2}",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "For nonzero z write N(z)=z/||z||",
          "source_start": 99,
          "source_end": 131,
          "tex": "N(z)=\\frac{z}{\\lVert z\\rVert}\\qquad(z\\ne0)",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "x!=0, y is initially arbitrary, and a real delta satisfies 0<=delta and ||x-y||<=delta<||x||",
          "source_start": 339,
          "source_end": 431,
          "tex": "x\\ne0,\\qquad 0\\le\\delta,\\qquad \\lVert x-y\\rVert\\le\\delta<\\lVert x\\rVert",
          "purpose": "given_question_notation"
        },
        {
          "source_excerpt": "||x||>=m>0 when 0<=delta<m",
          "source_start": 561,
          "source_end": 587,
          "tex": "\\lVert x\\rVert\\ge m>0,\\qquad 0\\le\\delta<m",
          "purpose": "given_question_notation"
        }
